---
import dayjs from 'dayjs'
import 'dayjs/locale/th'

import Footer from '../components/Footer.svelte'
import GoogleAd from '../components/GoogleAd.svelte'
import Hero from '../components/Hero.svelte'
import ProfileBadges from '../components/ProfileBadges.svelte'
import Resume from '../components/Resume.svelte'
import Header from '../components/sections/Header.svelte'
import WorkExperience from '../components/sections/WorkExperience.svelte'
import expData from '../i18n/experience.json'
import resumeData from '../i18n/resume.en.json'
import { getLangFromUrl } from '../i18n/utils'
import Layout from '../layouts/Layout.astro'
import { loadWorkHtml } from '../utils/workContent'

interface Props {
  resume: any
  experience?: any
}

const lang = getLangFromUrl(Astro.url)
const { experience = expData, resume = resumeData } = Astro.props

dayjs.locale(lang)

const workHtml = await loadWorkHtml(lang)
const adSlot = import.meta.env.PUBLIC_ADSENSE_HOME_SLOT
---

<Layout
  title={`${resume.fullname} - ${resume.job} | Portfolio & Resume`}
  description={resume.detail.substring(0, 180) + (resume.detail.length > 180 ? '...' : '')}
  image="/fb-social.jpg"
  keyword="kananek,t.,kananek-thongkam,thongkam,tk,resume,kem,kanane,kt"
>
  <Hero client:load lang={lang} resume={resume} interview={experience.interview} />
  <main class="relative z-10 max-w-7xl mx-auto px-4 pt-5 pb-8 md:pt-17 md:pb-12">
    {
      adSlot && (
        <div class="container my-4 print:hidden">
          <GoogleAd client:visible adSlot={adSlot} />
        </div>
      )
    }
    <Header lang={lang} resume={resume} experience={experience}>
      <ProfileBadges client:idle slot="badges" />
    </Header>
    <Resume lang={lang} resume={resume} experience={experience} />
    <div class="pagebreak" aria-hidden="true"></div>
    <WorkExperience lang={lang} workExperience={resume.work} workHtml={workHtml} />
    <Footer lang={lang} />
  </main>
</Layout>
