---
import { GoogleFontsOptimizer } from 'astro-google-fonts-optimizer'
import chartsCss from 'charts.css/dist/charts.css?raw'

import { getLangFromUrl } from '../i18n/utils'
import { pageUrl, profileLinks, SITE } from '../utils/seo'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  image: string
  keyword: string
  /** Page owner's name in the page language, used for the Open Graph profile tags. */
  fullname: string
  /** schema.org JSON-LD graph rendered into the head. */
  structuredData?: Record<string, unknown>
}
const { title: pageTitle, description: pageDescription, image, keyword = '', fullname, structuredData } = Astro.props
const pageImage = image || '/cover/ebdf8cdd-92ef-4523-849a-7a1838c750b3.jpg'
const pageImageUrl = pageImage.startsWith('https') ? pageImage : SITE + pageImage

const date = new Date().toISOString()

const lang = getLangFromUrl(Astro.url)
const canonicalUrl = pageUrl(lang)
const markdownUrl = lang === 'th' ? '/th/index.md' : '/index.md'
const ogLocale = { en: 'en_US', th: 'th_TH' }
const [firstName, ...lastName] = fullname.split(' ')
// Escape "<" so no string inside the JSON can close the script element.
const jsonLd = structuredData && JSON.stringify(structuredData).replace(/</g, '\u003c')
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keyword} />
    <meta name="author" content="Kananek Thongkam" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={pageUrl('en')} />
    <link rel="alternate" hreflang="th" href={pageUrl('th')} />
    <link rel="alternate" hreflang="x-default" href={pageUrl('en')} />
    <link rel="alternate" type="text/markdown" href={markdownUrl} />
    <link rel="describedby" href="/llms.txt" />
    {profileLinks().map((url) => <link rel="me" href={url} />)}
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/webp" sizes="64x64" href="/icon-64.webp" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="application-name" content="dvgamerr.app" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#C84B31" />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === 'th' ? 'en' : 'th']} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="dvgamerr.app" />
    <meta property="og:updated_time" content={date} />
    <meta property="og:image" content={pageImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="profile:first_name" content={firstName} />
    <meta property="profile:last_name" content={lastName.join(' ')} />
    <meta property="profile:username" content="dvgamerr" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:site" content="@dvgamerr" />
    <meta name="twitter:creator" content="@dvgamerr" />
    <meta name="twitter:image" content={pageImageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <meta name="twitter:image:width" content="1200" />
    <meta name="twitter:image:height" content="630" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    {import.meta.env.PUBLIC_ADSENSE_CLIENT && <meta name="google-adsense-account" content={import.meta.env.PUBLIC_ADSENSE_CLIENT} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      let stored = localStorage.getItem('theme')
      // only accept explicit values
      let theme =
        stored === 'dark' || stored === 'light' ? stored : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      let root = document.documentElement
      if (theme === 'dark') root.classList.add('dark')
      else root.classList.add('light')
      let meta = document.querySelector('meta[name="theme-color"]')
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#0f121f' : '#C84B31')
    </script>
    <GoogleFontsOptimizer
      url="https://fonts.googleapis.com/css2?family=Bai+Jamjuree:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&family=Hind:wght@300;400;500;600;700&display=swap"
    />
    <style set:html={chartsCss}></style>
    {
      import.meta.env.PROD && import.meta.env.PUBLIC_ADSENSE_CLIENT && (
        <>
          <script
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`}
            crossorigin="anonymous"
          />
          <script async src="https://rum.cronitor.io/script.js" />
        </>
      )
    }
  </head>
  <body>
    <div id="__layout">
      <slot />
    </div>
    <script>
      // @ts-ignore: any
      window.cronitor =
        // @ts-ignore: any
        window.cronitor ||
        function () {
          // @ts-ignore: any
          ;(window.cronitor.q = window.cronitor.q || []).push(arguments)
        }
      // @ts-ignore: any
      cronitor('config', { clientKey: 'a08df15d735c0c7518246129767fd319' })
    </script>
  </body>
</html>
<style is:global>
  .th-label {
    font-family: 'Bai Jamjuree', 'Segoe UI' !important;
  }

  #__layout {
    border-top: 5px solid var(--text-color-link);
  }

  @media print {
    #__layout {
      border-top: none !important;
    }
  }

  @media (max-width: 48rem) {
    #__layout {
      padding: 0 !important;
    }
  }
</style>
